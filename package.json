{
  "name": "metro-live",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@8.15.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=8.15.5"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:front": "turbo run dev --filter=@metro/frontend",
    "dev:back": "turbo run dev --filter=@metro/backend",
    "build": "turbo run build",
    "build:front": "turbo run build --filter=@metro/frontend",
    "build:back": "turbo run build --filter=@metro/backend",
    "lint": "pnpm typecheck",
    "typecheck": "pnpm build",
    "test": "pnpm build && pnpm --filter @metro/backend test && node --test tools/test/*.test.mjs",
    "test:integration": "node tools/test-compose.mjs",
    "release": "node tools/release.mjs",
    "version:check": "node tools/version.mjs",
    "clean": "turbo run clean",
    "extract:stations": "node tools/extract-stations.mjs",
    "purge:nm": "pnpm dlx rimraf --glob \"**/node_modules\" node_modules",
    "purge:cache": "pnpm dlx rimraf --glob \"**/.turbo\" \"**/.vite\" \"**/.cache\" \"**/tsconfig.tsbuildinfo\"",
    "purge:dist": "pnpm dlx rimraf --glob \"**/dist\" dist",
    "purge:types": "pnpm dlx rimraf --glob \"**/tsconfig.tsbuildinfo\" \"**/*.tsbuildinfo\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "turbo": "^2.0.6"
  }
}
