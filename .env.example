# Copiar para .env (ignorado pelo Git). Apenas a app publica uma porta na LAN.
APP_PORT=8080
APP_IMAGE_TAG=1.0.3

# Token pessoal da API oficial do Metro, necessário no modo real.
METRO_API_BASE=https://api.metrolisboa.pt:8243/estadoServicoML/1.0.1/
METRO_API_KEY=
METRO_MOCK=0
POLL_INTERVAL_MS=2000
DWELL_SECONDS=25
REDIS_TTL_SECONDS=15

# Optional station-location tile provider. Leave empty for OpenStreetMap.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=

# Apenas para desenvolvimento fora do Compose:
REDIS_URL=redis://localhost:6379
# NODE_EXTRA_CA_CERTS deve ser definido antes de arrancar o Node.
