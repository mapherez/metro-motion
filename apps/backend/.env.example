# Preferir o .env da raiz, documentado em ../../.env.example.
# Este ficheiro serve apenas para executar o backend fora de Docker.
METRO_API_BASE=https://api.metrolisboa.pt:8243/estadoServicoML/1.0.1/
METRO_API_KEY=
METRO_MOCK=0
REDIS_URL=redis://localhost:6379
POLL_INTERVAL_MS=2000
DWELL_SECONDS=25
REDIS_TTL_SECONDS=15
PORT=8080
# NODE_EXTRA_CA_CERTS deve ser definido antes de arrancar Node;
# o script dev já configura ../../infra/certs/metro-ca-bundle.pem.
